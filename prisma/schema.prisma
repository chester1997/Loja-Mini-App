generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// NEXTAUTH MODELS
// -------------------------------------------------------------
model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  favorites     Favorite[]
  purchases     Purchase[]
  watchProgress WatchProgress[]
  watchHistory  WatchHistory[]
  payments      Payment[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -------------------------------------------------------------
// APP MODELS (Phase 1)
// -------------------------------------------------------------
model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique @map("user_id")
  name       String?
  avatarUrl  String?  @map("avatar_url")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// -------------------------------------------------------------
// APP MODELS (Phase 2 - Home & Content)
// -------------------------------------------------------------
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  imageUrl    String?  @map("image_url")
  position    Int      @default(0)
  active      Boolean  @default(true)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  contents    ContentCategory[]
  sections    HomeSection[]

  @@map("categories")
}

model Content {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String?  @db.Text
  shortDescription String?  @map("short_description") @db.Text
  coverUrl         String?  @map("cover_url")
  bannerUrl        String?  @map("banner_url")
  trailerUrl       String?  @map("trailer_url")
  videoUrl         String?  @map("video_url")
  price            Decimal? @db.Decimal(10, 2)
  active           Boolean  @default(true)
  featured         Boolean  @default(false)
  publishedAt      DateTime? @map("published_at")
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  categories       ContentCategory[]
  homeBanners      HomeBanner[]
  favorites        Favorite[]
  purchases        Purchase[]
  watchProgress    WatchProgress[]
  watchHistory     WatchHistory[]

  @@map("contents")
}

model ContentCategory {
  contentId  String @map("content_id")
  categoryId String @map("category_id")

  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contentId, categoryId])
  @@map("content_categories")
}

model HomeSection {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  type       String   // e.g., CONTINUE_WATCHING, FEATURED, LATEST, CATEGORY, BEST_SELLERS, CUSTOM
  categoryId String?  @map("category_id")
  position   Int      @default(0)
  active     Boolean  @default(true)
  limit      Int      @default(10)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("home_sections")
}

model HomeBanner {
  id                  String   @id @default(cuid())
  title               String?
  subtitle            String?
  description         String?  @db.Text
  imageUrl            String?  @map("image_url")
  contentId           String?  @map("content_id")
  buttonPrimaryText   String?  @map("button_primary_text")
  buttonSecondaryText String?  @map("button_secondary_text")
  position            Int      @default(0)
  active              Boolean  @default(true)

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  content             Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@map("home_banners")
}

// -------------------------------------------------------------
// APP MODELS (Phase 3 - Favorites)
// -------------------------------------------------------------
model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  contentId String   @map("content_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("favorites")
}

// -------------------------------------------------------------
// APP MODELS (Phase 4 & 6 - User Area, Purchases & Payments)
// -------------------------------------------------------------
model Purchase {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  contentId   String   @map("content_id")
  amount      Decimal? @db.Decimal(10, 2)
  currency    String   @default("BRL")
  status      String   @default("pending") // pending, paid, cancelled, expired, refunded
  purchasedAt DateTime? @map("purchased_at")
  paidAt      DateTime? @map("paid_at")
  expiresAt   DateTime? @map("expires_at")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@index([userId])
  @@index([contentId])
  @@index([status])
  @@map("purchases")
}

model Payment {
  id                  String   @id @default(cuid())
  purchaseId          String   @map("purchase_id")
  userId              String   @map("user_id")
  provider            String   @default("cora")
  providerPaymentId   String   @map("provider_payment_id")
  providerCode        String?  @map("provider_code")
  amount              Decimal  @db.Decimal(10, 2)
  status              String   @default("pending")
  pixCopyPaste        String?  @map("pix_copy_paste") @db.Text
  qrCodeUrl           String?  @map("qr_code_url") @db.Text
  idempotencyKey      String   @unique @map("idempotency_key")
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  paidAt              DateTime? @map("paid_at")

  purchase            Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@map("payments")
}

model WatchProgress {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  contentId        String   @map("content_id")
  positionSeconds  Int      @default(0) @map("position_seconds")
  durationSeconds  Int      @default(0) @map("duration_seconds")
  progressPercentage Int    @default(0) @map("progress_percentage")
  lastWatchedAt    DateTime @default(now()) @map("last_watched_at")
  completed        Boolean  @default(false)
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content          Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("watch_progress")
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  contentId String   @map("content_id")
  watchedAt DateTime @default(now()) @map("watched_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("watch_history")
}
